# Inbound PoP (Signed HTTP Request) validation for an app-only token. The caller supplies the
# original request line the SHR was signed over via the original-method / original-uri headers.
GET {{Microsoft.Identity.Web.Sidecar_HostAddress}}/Validate
Authorization: PoP {{PopToken}}
original-method: GET
original-uri: https://api.contoso.com/data
